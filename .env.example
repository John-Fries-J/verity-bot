# Optional runtime overrides read by docker-compose.yml.
# The bot still expects config.json for most server/channel/role settings.

# Use this instead of putting the Discord token in config.json if preferred.
DISCORD_TOKEN=

# Optional. If unset, the bot uses static Verity lore fallback replies.
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=

TZ=Europe/London
